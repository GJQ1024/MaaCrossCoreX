  "邮件领取_门禁": {
    "recognition": {
      "type": "DirectHit"
    },
    "action": {
      "type": "Custom",
      "param": {
        "custom_action": "mail_claim_gate",
        "custom_action_param": {}
      }
    },
    "on_error": [
      "邮件领取_失败"
    ],
    "next": [
      "邮件_资源前"
    ],
    "next_doc": "进邮箱之前做幂等判定：需要跳过时由 mail_claim_gate 把 next 覆盖为「邮件领取_跳过」正常收尾；on_error 只留给后续节点识别超时等真实故障。2026-11-10 假成功：锚点检查 20.5s 超时被记到本节点，on_error 走跳过终端，0 封也报成功。2026-11-15 资源统计接入：门禁放行后才打 before，拦截时不留孤儿"
  },

  "邮件_资源前": {
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "resource_stats",
    "custom_action_param": { "task": "MailAttachments", "phase": "before" },
    "next": [
      "邮件领取_锚点检查"
