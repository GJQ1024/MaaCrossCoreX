      }
    },
    "timeout": 300000,
    "on_error": [
      "邮件领取_失败"
    ],
    "next": [
      "邮件领取_完成"
    ],
    "next_doc": "一键优先、逐封兜底；每封三重校验（计数-1 + 按钮变删除 + 底部已领取）；无附件邮件跳过；失败不假成功"
  },

  "邮件领取_失败": {
